CodeSystem: IdentifierTypeCS
Id: identifier-type-cs
Title: "Identifier Type CS"
Description: "Identifier Types"
* ^status = #active
* ^experimental = true 
* ^publisher = "Uzinfocom"
* insert SupplementCodeSystemDraft(identifier-type-cs, $identifier-type, 5.0.0)


* #NI "JShShIR"
  * ^designation[0].language = #ru
  * ^designation[=].value = "ПИНФЛ"
  * ^designation[+].language = #en
  * ^designation[=].value = "Personal Identification Number of an Individual"

* #PPN "Seriya va pasport raqami"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Серия и номер паспорта"
  * ^designation[+].language = #en
  * ^designation[=].value = "Passport series and number"

* #BCT "Tug'ilganlik haqidagi guvohnomaning seriyasi va raqami"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Серия и номер свидетельства о рождении"
  * ^designation[+].language = #en
  * ^designation[=].value = "Birth certificate series and number"

* #DL "Haydovchilik guvohnomasi seriyasi va raqami"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Серия и номер водительского удостоверения"
  * ^designation[+].language = #en
  * ^designation[=].value = "Driver's license series and number"

* #DP "Diplomatik pasport seriyasi va raqami"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Серия и номер дипломатического паспорта"
  * ^designation[+].language = #en
  * ^designation[=].value = "Diplomatic passport series and number"

* #HC "Tibbiy karta raqami"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Номер медицинской карты"
  * ^designation[+].language = #en
  * ^designation[=].value = "Medical card number"

* #MI "Harbiy guvohnomaning seriyasi va raqami"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Серия и номер военного билета"
  * ^designation[+].language = #en
  * ^designation[=].value = "Military ID series and number"

* #PCN "Qamoqqa olingan shaxsga berilgan raqam"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Номер, присваиваемый человеку, находящемуся в заключении"
