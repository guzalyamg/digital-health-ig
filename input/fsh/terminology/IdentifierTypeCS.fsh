  * ^designation[=].value = "Number assigned to a person in prison"

* #MD "Nomer meditsinskiy litsenziyasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Номер медицинской лицензии"
  * ^designation[+].language = #en
