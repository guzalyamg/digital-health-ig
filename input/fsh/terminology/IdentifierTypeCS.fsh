* #EN "Ish beruvchi raqami"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Номер работодателя"
  * ^designation[+].language = #en
  * ^designation[=].value = "Employer number"

* #TAX "STIR"
  * ^designation[0].language = #ru
  * ^designation[=].value = "ИНН"
  * ^designation[+].language = #en
  * ^designation[=].value = "Tax ID number"

